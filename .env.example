# Copy to .env for docker-compose (api + worker services)
API_TOKEN=dev-token
MAX_UPLOAD_BYTES=20971520
STORAGE_ROOT=/data/uploads
PORT=8080

# LLM/OCR providers (worker only). "stub" (default, needs nothing else
# set) or "anthropic" (real Claude calls/vision OCR, shares one key —
# requires ANTHROPIC_API_KEY below or the worker fails to start; see
# internal/providers/llm and internal/providers/ocr).
LLM_PROVIDER=stub
OCR_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
