# Copy to .env for docker-compose (api + worker services)
API_TOKEN=dev-token
MAX_UPLOAD_BYTES=20971520
STORAGE_ROOT=/data/uploads
PORT=8080

# LLM provider for classify_document/extract_fields (worker only).
# "stub" (default) needs nothing else set. "anthropic" requires a real
# key below, or the worker fails to start (internal/providers/llm).
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
